<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<!-- fx:controller conecta este archivo con ClienteViewController -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fastbite.controller.ClienteViewController"
      spacing="0"
      style="-fx-background-color: #0D1117;">

    <!-- ══ ENCABEZADO ══════════════════════════════════════════════ -->
    <HBox style="-fx-background-color: #161B22; -fx-padding: 16 24; -fx-border-color: #30363D; -fx-border-width: 0 0 1 0;">
        <Label text="⭐ Sistema de Fidelización"
               style="-fx-text-fill: #E6EDF3; -fx-font-size: 20px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- ══ PESTAÑAS ════════════════════════════════════════════════ -->
    <TabPane VBox.vgrow="ALWAYS"
             style="-fx-background-color: #0D1117; -fx-tab-min-height: 38px;">

        <!-- ══ PESTAÑA 1: Registrar Cliente ══════════════════════ -->
        <Tab text="➕  Registrar Cliente" closable="false">
            <VBox spacing="0" style="-fx-background-color: #0D1117;">

                <!-- Formulario -->
                <VBox spacing="14" style="-fx-background-color: #161B22; -fx-padding: 24; -fx-border-color: #30363D; -fx-border-width: 0 0 1 0;">
                    <Label text="Datos del nuevo cliente"
                           style="-fx-text-fill: #8B949E; -fx-font-size: 12px;"/>

                    <!-- Fila 1: Nombre y Apellido -->
                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Nombre *" style="-fx-text-fill: #E6EDF3;"/>
                            <TextField fx:id="campoNombre"
                                       promptText="ej: Juan"
                                       style="-fx-background-color: #0D1117; -fx-text-fill: #E6EDF3; -fx-border-color: #30363D; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-prompt-text-fill: #555;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Apellido *" style="-fx-text-fill: #E6EDF3;"/>
                            <TextField fx:id="campoApellido"
                                       promptText="ej: Pérez"
                                       style="-fx-background-color: #0D1117; -fx-text-fill: #E6EDF3; -fx-border-color: #30363D; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-prompt-text-fill: #555;"/>
                        </VBox>
                    </HBox>

                    <!-- Fila 2: Email y Teléfono -->
                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Email *" style="-fx-text-fill: #E6EDF3;"/>
                            <TextField fx:id="campoEmail"
                                       promptText="ej: juan@email.com"
                                       style="-fx-background-color: #0D1117; -fx-text-fill: #E6EDF3; -fx-border-color: #30363D; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-prompt-text-fill: #555;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Teléfono" style="-fx-text-fill: #E6EDF3;"/>
                            <TextField fx:id="campoTelefono"
                                       promptText="ej: 3001234567"
                                       style="-fx-background-color: #0D1117; -fx-text-fill: #E6EDF3; -fx-border-color: #30363D; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-prompt-text-fill: #555;"/>
                        </VBox>
                    </HBox>

                    <!-- Botón registrar -->
                    <Button text="Registrar Cliente"
                            onAction="#onClickRegistrar"
                            style="-fx-background-color: #238636; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;"
                            maxWidth="200"/>

                    <!-- Mensaje de resultado -->
                    <Label fx:id="etiquetaMensajeRegistro" text="" wrapText="true"
                           style="-fx-font-size: 13px;"/>
                </VBox>

                <!-- Tabla de clientes -->
                <VBox spacing="8" VBox.vgrow="ALWAYS" style="-fx-padding: 16;">
                    <Label text="Clientes registrados"
                           style="-fx-text-fill: #8B949E; -fx-font-size: 12px;"/>
                    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #161B22; -fx-border-color: #30363D;">
                        <columns>
                            <TableColumn fx:id="columnaId"        text="ID"        prefWidth="60"/>
                            <TableColumn fx:id="columnaNombre"    text="Nombre"    prefWidth="200"/>
                            <TableColumn fx:id="columnaEmail"     text="Email"     prefWidth="220"/>
                            <TableColumn fx:id="columnaTelefono"  text="Teléfono"  prefWidth="120"/>
                            <TableColumn fx:id="columnaPuntos"    text="Puntos"    prefWidth="100"/>
                            <TableColumn fx:id="columnaCategoria" text="Categoría" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="No hay clientes aún."
                                   style="-fx-text-fill: #555;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </Tab>

        <!-- ══ PESTAÑA 2: Puntos ══════════════════════════════════ -->
        <Tab text="Puntos" closable="false">
            <VBox spacing="20" style="-fx-background-color: #0D1117; -fx-padding: 24;">

                <Label text="Gestión de puntos"
                       style="-fx-text-fill: #8B949E; -fx-font-size: 12px;"/>

                <!-- Formulario de puntos -->
                <VBox spacing="12" style="-fx-background-color: #161B22; -fx-padding: 20; -fx-border-color: #30363D; -fx-border-radius: 8; -fx-background-radius: 8;">

                    <HBox spacing="12">
                        <VBox spacing="5">
                            <Label text="ID del cliente" style="-fx-text-fill: #E6EDF3;"/>
                            <TextField fx:id="campoIdPuntos"
                                       promptText="ej: 1"
                                       prefWidth="120"
                                       style="-fx-background-color: #0D1117; -fx-text-fill: #E6EDF3; -fx-border-color: #30363D; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-prompt-text-fill: #555;"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Cantidad de puntos" style="-fx-text-fill: #E6EDF3;"/>
                            <TextField fx:id="campoCantidadPuntos"
                                       promptText="ej: 100"
                                       prefWidth="150"
                                       style="-fx-background-color: #0D1117; -fx-text-fill: #E6EDF3; -fx-border-color: #30363D; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-prompt-text-fill: #555;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Descripción (opcional)" style="-fx-text-fill: #E6EDF3;"/>
                            <TextField fx:id="campoDescripcionPuntos"
                                       promptText="ej: Compra en tienda"
                                       style="-fx-background-color: #0D1117; -fx-text-fill: #E6EDF3; -fx-border-color: #30363D; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-prompt-text-fill: #555;"/>
                        </VBox>
                    </HBox>

                    <!-- Botones -->
                    <HBox spacing="10">
                        <Button text="➕  Agregar Puntos"
                                onAction="#onClickAgregarPuntos"
                                style="-fx-background-color: #238636; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 16; -fx-cursor: hand;"/>
                        <Button text="➖  Canjear Puntos"
                                onAction="#onClickCanjearPuntos"
                                style="-fx-background-color: #B91C1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 16; -fx-cursor: hand;"/>
                    </HBox>

                    <Label fx:id="etiquetaMensajePuntos" text="" wrapText="true"
                           style="-fx-font-size: 13px;"/>
                </VBox>

                <!-- Historial -->
                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <Label text="Historial de movimientos"
                           style="-fx-text-fill: #8B949E; -fx-font-size: 12px;"/>
                    <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #161B22; -fx-border-color: #30363D;">
                        <columns>
                            <TableColumn fx:id="columnaHTipo"        text="Tipo"        prefWidth="140"/>
                            <TableColumn fx:id="columnaHCantidad"    text="Puntos"      prefWidth="100"/>
                            <TableColumn fx:id="columnaHDescripcion" text="Descripción" prefWidth="280"/>
                            <TableColumn fx:id="columnaHFecha"       text="Fecha"       prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="No hay movimientos aún."
                                   style="-fx-text-fill: #555;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </Tab>

        <!-- ══ PESTAÑA 3: Consultar ═══════════════════════════════ -->
        <Tab text="🔍  Consultar" closable="false">
            <VBox spacing="16" style="-fx-background-color: #0D1117; -fx-padding: 24;">
                <Label text="Consultar puntos de un cliente"
                       style="-fx-text-fill: #8B949E; -fx-font-size: 12px;"/>

                <VBox spacing="12" style="-fx-background-color: #161B22; -fx-padding: 20; -fx-border-color: #30363D; -fx-border-radius: 8; -fx-background-radius: 8;" maxWidth="400">
                    <Label text="ID del cliente" style="-fx-text-fill: #E6EDF3;"/>
                    <TextField fx:id="campoIdConsulta"
                               promptText="Escribe el ID del cliente"
                               style="-fx-background-color: #0D1117; -fx-text-fill: #E6EDF3; -fx-border-color: #30363D; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-prompt-text-fill: #555;"/>
                    <Button text="Consultar"
                            onAction="#onClickConsultar"
                            style="-fx-background-color: #1F6FEB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;"/>
                    <Label fx:id="etiquetaResultadoConsulta" text=""
                           wrapText="true"
                           style="-fx-font-size: 14px;"/>
                </VBox>
            </VBox>
        </Tab>

    </TabPane>

</VBox>
