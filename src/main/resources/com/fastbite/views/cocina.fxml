<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fastbite.controller.CocinaViewController"
            stylesheets="@fastbite.css">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <Label text="FastBite - Modulo de Cocina" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblFecha" styleClass="header-info"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.45" orientation="HORIZONTAL">

            <VBox spacing="10" styleClass="panel">
                <padding><Insets top="16" right="12" bottom="16" left="16"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Pedidos Pendientes" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Actualizar" styleClass="btn-secondary" onAction="#handleActualizar"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Filtrar:"/>
                    <ComboBox fx:id="cmbFiltroEstado" promptText="Todos los estados"
                              onAction="#handleFiltrarEstado" prefWidth="200"/>
                </HBox>

                <ListView fx:id="listaPedidos" VBox.vgrow="ALWAYS"
                          onMouseClicked="#handleSeleccionarPedido"/>

                <HBox spacing="8" alignment="CENTER">
                    <Button fx:id="btnIniciarPreparacion" text="Iniciar Preparacion"
                            styleClass="btn-primary" onAction="#handleIniciarPreparacion"
                            disable="true"/>
                    <Button fx:id="btnMarcarListo" text="Marcar Listo"
                            styleClass="btn-success" onAction="#handleMarcarListo"
                            disable="true"/>
                </HBox>
            </VBox>

            <VBox spacing="10" styleClass="panel">
                <padding><Insets top="16" right="16" bottom="16" left="12"/></padding>

                <Label text="Detalle del Pedido" styleClass="panel-title"/>

                <GridPane fx:id="gridDetalle" hgap="12" vgap="8" visible="false">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130" prefWidth="130"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Numero:"  GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="lblNumeroPedido" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="field-value"/>
                    <Label text="Tipo:"    GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="lblTipoPedido"   GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="field-value"/>
                    <Label text="Estado:"  GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="lblEstadoPedido" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="field-value"/>
                    <Label text="Hora:"    GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="lblHoraPedido"   GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="field-value"/>
                    <Label text="Total:"   GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="lblTotalPedido"  GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="field-value-highlight"/>
                </GridPane>

                <Separator/>

                <Label text="Items del pedido:" styleClass="section-subtitle"/>

                <TableView fx:id="tablaItems" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProducto"   text="Producto"  prefWidth="180"/>
                        <TableColumn fx:id="colCantidad"   text="Cant."     prefWidth="60"/>
                        <TableColumn fx:id="colSubtotal"   text="Subtotal"  prefWidth="100"/>
                        <TableColumn fx:id="colEstadoItem" text="Estado"    prefWidth="110"/>
                    </columns>
                    <placeholder><Label text="Selecciona un pedido"/></placeholder>
                </TableView>

                <Label text="Observaciones:" styleClass="section-subtitle"/>
                <Label fx:id="lblObservaciones" wrapText="true" maxWidth="Infinity"/>

                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Button fx:id="btnMarcarItemListo" text="Marcar item listo"
                            styleClass="btn-outline" onAction="#handleMarcarItemListo"
                            disable="true"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="20">
            <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
            <Label fx:id="lblPendientes"    text="Pendientes: 0"     styleClass="status-info"/>
            <Label fx:id="lblEnPreparacion" text="En preparacion: 0" styleClass="status-info"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblMensaje" styleClass="status-msg"/>
        </HBox>
    </bottom>
</BorderPane>
